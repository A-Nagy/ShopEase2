<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm ="clr-namespace:ShopEase2.ViewModels"
             x:Class="ShopEase2.View.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="LoginPage"
             Shell.NavBarIsVisible="False"
             Shell.FlyoutBehavior="Disabled"
             BackgroundColor="#F8FAFC">
    <ScrollView>

        <VerticalStackLayout Padding="24,28"
                             Spacing="18">

            <Image Source="logo.png"
                   WidthRequest="96"
                   HeightRequest="96"
                   HorizontalOptions="Center"
                   SemanticProperties.Description="ShopEase logo" />

            <Label Text="Welcome back"
                   Style="{StaticResource TitleLabel}" />

            <Label Text="Sign in to explore products"
                   Style="{StaticResource SubtitleLabel}" />

            <Border Style="{StaticResource InputBorder}">
                <VerticalStackLayout Spacing="4">

                    <Label Text="Username or email"
                           Style="{StaticResource CaptionLabel}" />

                    <Entry Placeholder="Enter your username"
                           Text="{Binding Username, Mode=TwoWay}"
                           ReturnType="Next"
                           ClearButtonVisibility="WhileEditing" />

                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource InputBorder}">
                <VerticalStackLayout Spacing="4">

                    <Label Text="Password"
                           Style="{StaticResource CaptionLabel}" />

                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="8">

                        <Entry Grid.Column="0"
                               Placeholder="Enter your password"
                               Text="{Binding Password, Mode=TwoWay}"
                               IsPassword="{Binding IsPasswordHidden}"
                               ReturnType="Done" />

                        <ImageButton Grid.Column="1"
                                     Source="ic_eye.png"
                                     BackgroundColor="Transparent"
                                     WidthRequest="44"
                                     HeightRequest="44"
                                     Command="{Binding TogglePasswordVisibilityCommand}"
                                     SemanticProperties.Description="Show or hide password" />

                    </Grid>

                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding ErrorMessage}"
                   Style="{StaticResource ErrorLabel}"
                   IsVisible="{Binding HasError}" />

            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                Color="{StaticResource Primary}" />

            <Button Text="Sign in"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding LoginCommand}" />

            <Button Text="Use demo account"
                    Style="{StaticResource LinkButton}"
                    Command="{Binding UseDemoAccountCommand}" />

            <Label Text="New here? Create an account"
                   Style="{StaticResource SubtitleLabel}"
                   HorizontalOptions="Center" />

        </VerticalStackLayout>

    </ScrollView>


</ContentPage>